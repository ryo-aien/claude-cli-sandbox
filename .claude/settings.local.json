{
  "includeCoAuthoredBy": true,
  "permissions": {
    "allow": [
      "Bash(mkdir:*)",
      "Bash(tree:*)",
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(echo:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git clone:*)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(node:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(yarn install:*)",
      "Bash(pip install:*)",
      "Bash(cp:*)",
      "Bash(rm:*)",
      "Fetch(**)",
      "Web Search(**)",
      "Bash(git pull:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(done)",
      "Bash(xargs ls:*)",
      "Bash(find:*)",
      "Bash(chmod:*)",
      "WebFetch(domain:*)",
      "Bash(docker compose:*)",
      "Skill(**)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "WebSearch",
      "WebFetch(domain:claude.com)",
      "WebFetch(domain:support.claude.com)",
      "Bash(mkdir -p /workspace/.claude/commands/canvas-project-init/assets/template/data)",
      "Bash(mkdir -p /workspace/.claude/commands/canvas-project-init/assets/template/components/cards)",
      "Bash(mkdir -p /workspace/.claude/commands/canvas-project-init/assets/template/canvas)",
      "Read(**/.env.example)",
      "Edit(**/.env.example)",
      "Write(**/.env.example)"
    ],
    "deny": [
      "Bash(sudo:*)",
      "Bash(su :*)",
      "Bash(chmod 777 /:*)",
      "Bash(chmod -R 777 /:*)",
      "Bash(mkfs:*)",
      "Bash(dd if=:*)",
      "Bash(fdisk:*)",
      "Bash(eval:*)",
      "Bash(systemctl:*)",
      "Bash(reboot:*)",
      "Bash(shutdown:*)",
      "Bash(init:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard HEAD~:*)",
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(**/.env)",
      "Write(**/.env.*)"
    ],
    "defaultMode": "default"
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ENABLED=$(grep LINE_NOTIFY_ENABLED /workspace/.env | cut -d= -f2); [ \"$ENABLED\" != \"true\" ] && exit 0; TOKEN=$(grep LINE_NOTIFY_TOKEN /workspace/.env | cut -d= -f2) && curl -s -X POST https://api.line.me/v2/bot/message/broadcast -H \"Content-Type: application/json\" -H \"Authorization: Bearer $TOKEN\" -d \"{\\\"messages\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"Claude Code のタスクが完了しました！\\\"}]}\"'"
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'ENABLED=$(grep LINE_NOTIFY_ENABLED /workspace/.env | cut -d= -f2); [ \"$ENABLED\" != \"true\" ] && exit 0; TOKEN=$(grep LINE_NOTIFY_TOKEN /workspace/.env | cut -d= -f2) && curl -s -X POST https://api.line.me/v2/bot/message/broadcast -H \"Content-Type: application/json\" -H \"Authorization: Bearer $TOKEN\" -d \"{\\\"messages\\\":[{\\\"type\\\":\\\"text\\\",\\\"text\\\":\\\"⏸Claude Code が確認を求めています\\\"}]}\"'"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "github-marketplace": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code-marketplace"
      }
    },
    "skill-creator": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-code-skill-creator"
      }
    }
  },
  "language": "japanese",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": false,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowAllUnixSockets": false,
      "allowLocalBinding": true
    }
  },
  "spinnerTipsEnabled": true,
  "alwaysThinkingEnabled": false,
  "planStorage": {
    "path": "/workspace/.claude/plans"
  }
}
