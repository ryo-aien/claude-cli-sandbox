# ホストユーザーのUID/GID設定
# macOSの場合: id -u でUID、id -g でGIDを確認してください
HOST_UID=1000
HOST_GID=1000

# Claude CLI インストールコマンド（オプション）
# デフォルト: npm install -g @anthropics/claude
# カスタムコマンドを使用する場合はコメントアウトを解除して編集
# CLAUDE_INSTALL_CMD=npm install -g @anthropics/claude

# ワークスペースディレクトリ（オプション）
# デフォルト: カレントディレクトリ
# CLAUDE_WORKSPACE_DIR=./

# LINE Messaging API（Claude Code 通知用）
# https://developers.line.biz/console/ で Channel Access Token を発行
LINE_NOTIFY_ENABLED=true
LINE_NOTIFY_TOKEN=YOUR_CHANNEL_ACCESS_TOKEN_HERE
